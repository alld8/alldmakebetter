-- Dropdown Player List (Fixed inside frame)
local dropdownHolder = Instance.new("ScrollingFrame", frame)
dropdownHolder.Position = UDim2.new(0, 10, 0, 130)
dropdownHolder.Size = UDim2.new(1, -20, 0, 120)
dropdownHolder.BackgroundColor3 = themes[currentTheme].dropdown
dropdownHolder.BackgroundTransparency = 0.1
dropdownHolder.CanvasSize = UDim2.new(0, 0, 0, 0)
dropdownHolder.ScrollBarThickness = 6
Instance.new("UICorner", dropdownHolder)
local UIListLayout = Instance.new("UIListLayout", dropdownHolder)
UIListLayout.Padding = UDim.new(0, 4)
UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder

local selectedPlayer = nil
local function refreshDropdown()
    for _, child in ipairs(dropdownHolder:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local btn = Instance.new("TextButton", dropdownHolder)
            btn.Size = UDim2.new(1, 0, 0, 28)
            btn.BackgroundColor3 = Color3.fromRGB(120, 140, 180)
            btn.TextColor3 = Color3.new(1,1,1)
            btn.Text = plr.Name
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 14
            Instance.new("UICorner", btn)
            btn.MouseButton1Click:Connect(function()
                selectedPlayer = plr
                for _, b in ipairs(dropdownHolder:GetChildren()) do
                    if b:IsA("TextButton") then
                        b.BackgroundColor3 = Color3.fromRGB(120, 140, 180)
                    end
                end
                btn.BackgroundColor3 = Color3.fromRGB(70, 130, 180)
            end)
        end
    end
    dropdownHolder.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
end
refreshDropdown()

-- ESP Toggle
local espEnabled = false
local espBox = nil
local function createESP(target)
    if espBox then espBox:Destroy() end
    espBox = Instance.new("BoxHandleAdornment")
    espBox.Adornee = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    espBox.AlwaysOnTop = true
    espBox.ZIndex = 5
    espBox.Size = Vector3.new(3,6,1)
    espBox.Transparency = 0.3
    espBox.Color3 = Color3.fromRGB(255,0,0)
    espBox.Parent = target.Character
end
espBtn.MouseButton1Click:Connect(function()
    if selectedPlayer and selectedPlayer.Character then
        if espEnabled then
            if espBox then espBox:Destroy() espBox = nil end
            espBtn.Text = "ESP"
        else
            createESP(selectedPlayer)
            espBtn.Text = "UNESP"
        end
        espEnabled = not espEnabled
    end
end)

