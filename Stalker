local function createButton(name, pos)
    local btn = Instance.new("TextButton", frame)
    btn.Name = name
    btn.Size = UDim2.new(0.45, -5, 0, 35)
    btn.Position = pos
    btn.BackgroundColor3 = themes[currentTheme].button
