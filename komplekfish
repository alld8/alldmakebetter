-- Show GUI again with F key
UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == Enum.KeyCode.F then
        frame.Visible = true
    end
end)

-- Minimize button logic
minimizeBtn.MouseButton1Click:Connect(function()
    frame.Visible = false
end)

-- AUTO FISH FUNCTION
local function instantFish()
    while isFishing do
        pcall(function()
            -- Fire GUI impression (trigger start)
            guiRemote:FireServer({
                {
                    button_path = "ContextActionGui.ContextButtonFrame.ContextActionButton",
                    button_name = "ContextActionButton"
                }
            })

            local rod = player.Backpack:FindFirstChild("SunkenRod")
            local character = player.Character

            -- Auto Equip if needed
            if rod and not character:FindFirstChild("SunkenRod") then
                rod.Parent = character
                task.wait(0.1)
            end

            -- Fire Complete if equipped
            local equippedRod = character:FindFirstChild("SunkenRod")
            if equippedRod then
                local miniGame = equippedRod:FindFirstChild("MiniGame")
                if miniGame then
                    miniGame:FireServer("Complete")
                end
            end
        end)
        task.wait()
    end
end

-- Button logic
startBtn.MouseButton1Click:Connect(function()
    if not isFishing then
        isFishing = true
        coroutine.wrap(instantFish)()
    end
end)

stopBtn.MouseButton1Click:Connect(function()
    isFishing = false
end)
