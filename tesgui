--==[ Tab System ]==--
local tabs = {}
local currentTab = nil

local function createTabContent(name)
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.Size = UDim2.new(1, 0, 1, 0)
	frame.BackgroundTransparency = 1
	frame.Visible = false
	frame.Parent = contentPanel
	tabs[name] = frame
	return frame
end

local function switchTab(name)
	for tabName, frame in pairs(tabs) do
		frame.Visible = (tabName == name)
	end
	currentTab = name
end

local function moveIndicatorTo(button)
	local targetY = button.Position.Y.Offset + ((button.Size.Y.Offset - TabIndicator.Size.Y.Offset) / 2)
	TabIndicator:TweenPosition(
		UDim2.new(0, 2, 0, targetY),
		Enum.EasingDirection.Out,
		Enum.EasingStyle.Quad,
		0.2,
		true
	)
end

local function createTabButton(name, order)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 70, 0, 20)
	btn.Position = UDim2.new(0, 5, 0, 38 + ((order - 1) * 25))
	btn.Text = name
	btn.Font = Enum.Font.SourceSansSemibold
	btn.TextSize = 16
	btn.BackgroundColor3 = Color3.fromRGB(0, 145, 255)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Parent = tabList

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = btn

	btn.MouseButton1Click:Connect(function()
		switchTab(name)
		moveIndicatorTo(btn)
	end)

	return btn
end

